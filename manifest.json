{
  "manifest_version": 3,
  "name": "NoRovo",
  "version": "0.1.1",
  "description": "Disable Rovo when using Atlassian products.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "NoRovo"
  },
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "norovo@sgerrand.dev"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
